# pyenv
#   For a library or binary, you wish to ignore their .python-version file.
#   For a project, you usually want to keep it, to aid developers in using the same Python version.
# .python-version

# pipenv
#   According to pypa/pipenv#1185, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having cross-platform versions, pipenv may install dependencies that don't work, or even
#   fail to install them. In that case, it is recommended to ignore Pipfile.lock.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
# poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in version control.
# pdm.lock
#   pdm local configuration
.pdm-python
.pdm-build/

